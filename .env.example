APP_ENV=development
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
AUTO_CREATE_DB=false
DATABASE_URL=postgresql+asyncpg://safescroll:safescroll@localhost:5432/safescroll
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_SECRET=replace-with-32-plus-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=35
SAFESCROLL_MODE=zero
LOCAL_MODEL_ENABLED=true

WEB_RISK_ENABLED=false
WEB_RISK_API_KEY=
WEB_RISK_THREAT_TYPES=SOCIAL_ENGINEERING,MALWARE,UNWANTED_SOFTWARE

RATE_LIMIT_PER_MINUTE=60
SCAN_MAX_CHARS=12000
IMAGE_MAX_BYTES=8000000

SENTRY_DSN=
OTEL_SERVICE_NAME=safescroll-api
METRICS_ENABLED=true

RULES_SIGNING_PUBLIC_KEY_B64=
RULES_REQUIRE_SIGNATURE=true
